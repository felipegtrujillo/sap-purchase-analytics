projection;
strict ( 2 );

define behavior for ZFGT_C_PurchaseOrderTP alias PurchaseOrder
use etag
{
  use create;
  use update;
  use delete;

  use association _Item { create; }
}

define behavior for ZFGT_C_PurchaseOrderItemTP alias PurchaseOrderItem
use etag
{
  use update;
  use delete;

  use association _PurchaseOrder;
}